generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model intento_quiz {
  id_intento       Int     @id @default(autoincrement())
  id_usuario       Int
  id_quiz          Int
  calificacion     Int?
  puntos_otorgados Int?
  completado_100   Boolean @default(false)
  quiz             quiz    @relation(fields: [id_quiz], references: [id_quiz], onDelete: Cascade, onUpdate: NoAction, map: "fk_intento_quiz")
  usuario          usuario @relation(fields: [id_usuario], references: [id_usuario], onDelete: Cascade, onUpdate: NoAction, map: "fk_intento_usuario")
}

model logro {
  id_logro      Int             @id @default(autoincrement())
  titulo        String          @db.VarChar(150)
  descripcion   String?
  condicion     String?         @db.VarChar(255)
  icono         String?         @db.VarChar(255)
  usuario_logro usuario_logro[]
}

model modulo {
  id_modulo         Int                 @id @default(autoincrement())
  titulo            String              @db.VarChar(150)
  descripcion       String?
  orden             Int
  contenido_teorico String?
  id_curso          Int
  estatus           estatus_modulo      @default(activo)
  codigo_ejemplo    codigo_ejemplo[]
  curso             curso               @relation(fields: [id_curso], references: [id_curso], onDelete: Cascade, onUpdate: NoAction, map: "fk_modulo_curso")
  modulo_completado modulo_completado[]
  quiz              quiz[]
}

model pregunta {
  id_pregunta Int      @id @default(autoincrement())
  id_quiz     Int
  enunciado   String
  orden       Decimal? @db.Decimal
  opcion      opcion[]
  quiz        quiz     @relation(fields: [id_quiz], references: [id_quiz], onDelete: Cascade, onUpdate: NoAction, map: "fk_pregunta_quiz")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model quiz {
  id_quiz                Int            @id @default(autoincrement())
  id_modulo              Int
  titulo                 String         @db.VarChar(150)
  tiempo_limite_segundos Int?
  puntos_recompensa      Int?           @default(0)
  intento_quiz           intento_quiz[]
  pregunta               pregunta[]
  modulo                 modulo         @relation(fields: [id_modulo], references: [id_modulo], onDelete: Cascade, onUpdate: NoAction, map: "fk_quiz_modulo")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model rango {
  id_rango          Int       @id @default(autoincrement())
  titulo            String    @db.VarChar(100)
  puntos_requeridos Int
  icono             String?   @db.VarChar(255)
  usuario           usuario[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model usuario {
  id_usuario        Int                 @id @default(autoincrement())
  nombre            String              @db.VarChar(100)
  email             String              @unique @db.VarChar(150)
  password          String              @db.VarChar(255)
  id_rango_actual   Int?
  puntos_totales    Int?                @default(0)
  fecha_registro    DateTime?           @default(dbgenerated("CURRENT_DATE")) @db.Date
  rol               rol_usuario?        @default(student)
  curso_iniciado    curso_iniciado[]
  intento_quiz      intento_quiz[]
  modulo_completado modulo_completado[]
  token_usuario     token_usuario[]
  rango             rango?              @relation(fields: [id_rango_actual], references: [id_rango], onUpdate: NoAction, map: "fk_usuario_rango")
  usuario_logro     usuario_logro[]
}

model usuario_logro {
  id_relacion     Int       @id @default(autoincrement())
  id_usuario      Int
  id_logro        Int
  fecha_obtencion DateTime? @default(dbgenerated("CURRENT_DATE")) @db.Date
  logro           logro     @relation(fields: [id_logro], references: [id_logro], onDelete: Cascade, onUpdate: NoAction, map: "fk_usuario_logro_logro")
  usuario         usuario   @relation(fields: [id_usuario], references: [id_usuario], onDelete: Cascade, onUpdate: NoAction, map: "fk_usuario_logro_usuario")

  @@unique([id_usuario, id_logro], map: "unique_usuario_logro")
}

model curso {
  id_curso       Int              @id @default(autoincrement())
  titulo         String           @db.VarChar(50)
  descripcion    String
  fecha_creacion DateTime?        @default(dbgenerated("CURRENT_DATE")) @db.Date
  estado         estado_curso     @default(activo)
  imagen_url     String?
  curso_iniciado curso_iniciado[]
  modulo         modulo[]
}

model opcion {
  id_opcion   Int       @id @default(autoincrement())
  id_pregunta Int?
  Texto       String
  es_correcta Boolean   @default(false)
  orden       Decimal?  @db.Decimal
  explicacion String?
  pregunta    pregunta? @relation(fields: [id_pregunta], references: [id_pregunta], onDelete: Cascade, onUpdate: NoAction, map: "fk_opcion_pregunta")
}

model codigo_ejemplo {
  id_codigo_ejemplo  Int                    @id @default(autoincrement())
  explicacion_codigo String?
  codigo             String
  lenguaje           lenguaje_programacion?
  id_modulo          Int?
  modulo             modulo?                @relation(fields: [id_modulo], references: [id_modulo], onDelete: NoAction, onUpdate: NoAction, map: "fk_modulo_codigo")
}

model curso_iniciado {
  id_curso_iniciado Int       @id @default(autoincrement())
  id_usuario        Int
  id_curso          Int
  completado        Boolean   @default(false)
  fecha_completado  DateTime? @db.Timestamp(6)
  curso             curso     @relation(fields: [id_curso], references: [id_curso], onDelete: NoAction, onUpdate: NoAction, map: "fk_curso_iniciado_curso")
  usuario           usuario   @relation(fields: [id_usuario], references: [id_usuario], onDelete: NoAction, onUpdate: NoAction, map: "fk_curso_iniciado_usuario")

  @@unique([id_usuario, id_curso], map: "unique_usuario_curso")
}

model token_usuario {
  id_token   Int       @id @default(autoincrement())
  token      String    @unique @db.VarChar(255)
  tipo       TipoToken
  expiracion DateTime  @db.Timestamp(6)
  usado      Boolean   @default(false)
  id_usuario Int
  created_at DateTime  @default(now()) @db.Timestamp(6)
  usuario    usuario   @relation(fields: [id_usuario], references: [id_usuario], onDelete: Cascade, onUpdate: NoAction, map: "fk_token_usuario_usuario")
}

model modulo_completado {
  id_modulo_completado Int       @id @default(autoincrement())
  id_usuario           Int
  id_modulo            Int
  completado           Boolean   @default(false)
  fecha_completado     DateTime? @db.Timestamp(6)
  modulo               modulo    @relation(fields: [id_modulo], references: [id_modulo], onDelete: Cascade, onUpdate: NoAction, map: "fk_modulo_completado_modulo")
  usuario              usuario   @relation(fields: [id_usuario], references: [id_usuario], onDelete: Cascade, onUpdate: NoAction, map: "fk_modulo_completado_usuario")

  @@unique([id_usuario, id_modulo], map: "unique_usuario_modulo")
}

enum rol_usuario {
  student
  admin
}

enum estado_curso {
  activo
  eliminado
}

enum estatus_modulo {
  activo
  eliminado
}

enum lenguaje_programacion {
  C
  C__        @map("C++")
  Python
  JavaScript
  Java
  C_         @map("C#")
}

enum TipoToken {
  RESET_PASSWORD
  VERIFY_EMAIL
}
